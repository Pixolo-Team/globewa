---
interface Props {
  name: string;
  email: string;
}
const { name, email } = Astro.props;
---
<li class="card">
  <div class="avatar" aria-hidden="true">{name.charAt(0).toUpperCase()}</div>
  <div>
    <strong class="name">{name}</strong>
    <span class="email">{email}</span>
  </div>
</li>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 12px;
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #2563eb;
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 700;
  }
  .name { display: block; }
  .email { color: #64748b; font-size: 0.9rem; }
</style>