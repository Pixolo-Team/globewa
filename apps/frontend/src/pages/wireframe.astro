  .contact h1{font-size:52px;max-width:560px}
  .contact .sub{font-size:14px;max-width:500px}
  .reasons{margin-top:36px}
  .reason{padding:20px 0}
  .reach{margin-top:28px}
  .formcard{border:0;border-radius:0;background:transparent;padding:0;box-shadow:none}
  .formcard h3{font-size:22px;letter-spacing:-.03em}
  .formcard .fh{font-size:12px;margin-top:6px;max-width:340px}
  .fgrid{grid-template-columns:1fr 1fr;gap:26px 24px;margin-top:40px}
  .fld{gap:8px}
  .inp{height:auto;border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent;
    padding:0 0 10px;font-size:12.5px;color:#8B95A7;justify-content:flex-start}
  .inp.area{height:74px}
  .agree{margin-top:26px}
  .formcard>.btn{margin-top:22px}
  .endnote{text-align:center;padding:88px 0 96px;border-top:1px solid var(--line2)}
  .endnote p{font-size:14px;color:var(--body)}
  .endnote b{color:var(--ink);font-weight:600}

  /* ================= PREMIUM FINISH ================= */
  :root{
    --ink:#0B1220; --body:#4C5869; --muted:#6E7A8D; --faint:#98A2B3;
    --line:#E6EAF0; --line2:#EEF1F5; --navy:#080E17;
  }
  html,body{background:#E7EAF0}
  body{background:
    radial-gradient(1100px 640px at 16% -10%,#F4F7FB 0%,rgba(244,247,251,0) 62%),
    radial-gradient(900px 560px at 94% 4%,#EDF2F8 0%,rgba(237,242,248,0) 64%),
    #E7EAF0}
  .boards{gap:56px;padding:48px 0 104px}
  .board{border-radius:26px;
    box-shadow:0 1px 2px rgba(11,18,32,.05), 0 2px 10px rgba(11,18,32,.035),
      0 60px 120px -72px rgba(11,18,32,.55)}

  /* type */
  .hero h1,.phero h1,.pr-hero h1,.contact h1,
  .split-head h2,.cta-card h2,.cathead h3,.storyband h2,
  .pull blockquote,.statband b{font-weight:500}
  .hero h1{font-size:60px;line-height:1.02;letter-spacing:-.058em;max-width:740px}
  .phero h1{font-size:56px;letter-spacing:-.055em;max-width:740px}
  .pr-hero h1{font-size:58px;letter-spacing:-.058em;max-width:880px}
  .pr-hero{text-align:left}
  .pr-hero p{margin:18px 0 0;max-width:560px}
  .pr-tabs{justify-content:flex-start;margin-top:34px}
  .contact h1{font-size:54px;letter-spacing:-.055em}
  .split-head h2{font-size:42px;line-height:1.06;letter-spacing:-.05em;text-wrap:balance}
  .storyband h2{font-size:42px;line-height:1.06;letter-spacing:-.05em;text-wrap:balance}
  .cathead h3{font-size:31px;letter-spacing:-.048em}
  .cta-card h2{font-size:40px;line-height:1.08}
  .eyebrow{font-size:10px;letter-spacing:.18em;color:#7A8698}
  .eyebrow i{width:16px;height:1px;border-radius:0;background:#C3CBD6}

  /* nav + buttons */
  .util{height:34px;font-size:10px;letter-spacing:.01em;border-bottom-color:#EDF0F4}
  .nav{height:78px}
  .nav-links{gap:30px;font-size:12.5px;color:#5A667C}
  .btn{border-radius:11px;padding:13px 24px}
  .btn.sm{padding:9px 17px;border-radius:10px}
  .btn.green,.btn.navy{background:linear-gradient(180deg,#162032 0%,#0B1220 100%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.09), 0 1px 2px rgba(11,18,32,.28),
      0 14px 28px -18px rgba(11,18,32,.55)}
  .btn.ghost{background:#fff;border-color:#E4E8EE;
    box-shadow:0 1px 2px rgba(16,24,40,.04), 0 10px 24px -22px rgba(16,24,40,.35)}

  /* hero */
  .hero{grid-template-columns:1fr 300px;gap:60px;padding:100px 0 84px;position:relative;isolation:isolate}
  .hero::before{content:"";position:absolute;z-index:-1;left:-260px;top:-180px;width:980px;height:680px;
    background:radial-gradient(closest-side,rgba(27,42,66,.055),rgba(27,42,66,0) 72%);
    pointer-events:none}
  .hero .sub{font-size:15.5px;line-height:1.62;color:#4E5A6C;max-width:510px;margin-top:22px}
  .hero .row{margin-top:34px}
  .trustline{margin-top:36px;font-size:11.5px;color:#77839a}
  .hero-index{margin-top:6px}
  .hix{padding:22px 0}
  .hix b{font-size:13px;font-weight:500}
  .hix em{font-size:10.5px;letter-spacing:.02em;font-variant-numeric:tabular-nums}

  /* index + statements */
  .index{margin-top:56px}
  .ixrow{padding:30px 2px}
  .ixrow h4{font-size:21px;font-weight:500;letter-spacing:-.035em}
  .ixrow .ixc{font-variant-numeric:tabular-nums;font-size:11px}
  .slist{margin-top:56px}
  .sitem{padding:27px 2px}
  .sitem h4{font-size:16.5px;font-weight:500}
  .sitem p{font-size:12.5px;line-height:1.72}

  /* figures */
  .statband{margin-top:68px;padding-top:40px;gap:44px}
  .statband b{font-size:54px;letter-spacing:-.062em;font-variant-numeric:tabular-nums;
    font-feature-settings:"tnum" 1}
  .statband span{font-size:9.5px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;
    color:#8C98A9;margin-top:15px}

  /* pull quote */
  .pull blockquote{font-size:33px;line-height:1.34;letter-spacing:-.042em}

  /* dark cta */
  .cta-card{padding:84px 56px;border-radius:22px;
    background:linear-gradient(158deg,#152034 0%,#0A111D 54%,#0C1422 100%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.07), 0 40px 84px -54px rgba(11,18,32,.75)}
  .cta-card::before{background:
    radial-gradient(90% 120% at 50% -10%,rgba(120,160,220,.20),rgba(120,160,220,0) 60%),
    radial-gradient(60% 90% at 88% 110%,rgba(120,160,220,.10),rgba(120,160,220,0) 70%)}
  .cta-card::after{content:"";position:absolute;inset:0;pointer-events:none;
    background-image:linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);
    background-size:120px 100%;
    -webkit-mask-image:linear-gradient(180deg,transparent,#000 34%,#000 66%,transparent);
    mask-image:linear-gradient(180deg,transparent,#000 34%,#000 66%,transparent);
    opacity:.7}
  .cta-card h2{max-width:760px}
  .cta-card p{font-size:13.5px;color:rgba(255,255,255,.66)}

  /* services catalogue */
  .phero{padding:96px 0 60px}
  .phero p{font-size:14.5px;max-width:600px}
  .catgroup{padding:68px 0 0}
  .citem{padding:23px 0}
  .citem h4{font-size:15px;font-weight:500}
  .citem .meta{font-size:9px;letter-spacing:.14em;color:#AEB7C5}

  /* pricing */
  .pr-body{padding:60px 0 0}
  .rtable th{font-size:9px;letter-spacing:.14em;color:#97A2B3}
  .rtable td{padding:22px 0;font-size:13px}
  .rtable td b{font-size:20px;font-weight:500;letter-spacing:-.035em;
    font-variant-numeric:tabular-nums}
  .rtable td:first-child{font-variant-numeric:tabular-nums;letter-spacing:-.01em}
  .rtab span{font-size:11px;letter-spacing:.02em}
  .pfacts{font-size:11px;letter-spacing:.01em;padding:26px 0}

  /* dlt + company */
  .srow .st{font-size:9.5px;letter-spacing:.1em;text-transform:uppercase}
  .three .n,.step .n{font-size:9.5px;letter-spacing:.16em;color:#A6AFBF}
  .storyband .ph{border-radius:16px;
    background:linear-gradient(152deg,#F6F8FC 0%,#EDF1F7 46%,#E4EAF2 100%);
    box-shadow:inset 0 0 0 1px #E6EAF0, inset 0 1px 0 rgba(255,255,255,.8)}
  .storyband .meta b{font-size:27px;font-weight:500;letter-spacing:-.05em;
    font-variant-numeric:tabular-nums}

  /* footer */
  .foot{background:linear-gradient(180deg,#0A111C 0%,#080E17 100%)}
  .fcol a{letter-spacing:.005em}
  .foot-base{font-size:10.5px;letter-spacing:.01em}

  /* underline fields */
  .inp{border-bottom-color:#E2E7EE;transition:border-color .18s ease,color .18s ease}
  .inp:hover{border-bottom-color:#C8D1DE}
  .fld label{letter-spacing:.13em;color:#8E99AB}

  /* ================= SERVICES — FOUR DISTINCT MODULES ================= */
  .sm{margin-top:96px}
  .sm-ledger{margin-top:40px}
  .sm h3{font-size:34px;font-weight:500;letter-spacing:-.048em;line-height:1.06;margin-top:13px;text-wrap:balance}
  .sm-intro{max-width:680px}
  .sm-intro p{font-size:13.5px;line-height:1.7;color:var(--body);margin-top:13px;max-width:520px}

  /* 01 — rate ledger */
  .ledger{margin-top:46px;border-top:1px solid var(--line)}
  .lrow{display:grid;grid-template-columns:236px 1fr 200px;gap:32px;align-items:baseline;
    padding:24px 2px;border-bottom:1px solid var(--line2)}
  .lrow h4{font-size:16.5px;font-weight:500;letter-spacing:-.025em}
  .lrow p{font-size:12.5px;line-height:1.65;color:var(--body);max-width:520px}
  .lrow .lrate{justify-self:end;text-align:right;font-size:12.5px;font-weight:500;color:var(--ink);
    font-variant-numeric:tabular-nums;white-space:nowrap}
  .lrow .lrate small{display:block;font-size:9px;font-weight:600;letter-spacing:.12em;
    text-transform:uppercase;color:#A6AFBF;margin-top:5px}
  .sm-link{margin-top:30px}

  /* 02 — four columns */
  .sm-head{display:grid;grid-template-columns:1fr 340px;gap:96px;align-items:end}
  .sm-head h3{max-width:560px}
  .sm-side p{font-size:12.5px;line-height:1.75;color:var(--body);max-width:300px}
  .sm-side .flink{margin-top:12px;font-size:12px}
  .cols4{display:grid;grid-template-columns:repeat(4,1fr);gap:0 44px;margin-top:46px;
    border-top:1px solid var(--line);padding-top:30px}
  .c4{display:flex;flex-direction:column}
  .c4 .ic{width:18px;height:18px;color:#6B7688}
  .c4 h4{font-size:19px;font-weight:500;letter-spacing:-.03em;line-height:1.25;margin-top:22px;max-width:210px}
  .c4 p{font-size:12px;line-height:1.7;color:var(--body);margin-top:10px;max-width:220px}
  .c4 .rate{display:block;font-size:9px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
    color:#A0AABB;margin-top:auto;padding-top:24px}

  /* 03 — full-bleed automation band */
  .sm-dark{margin-top:100px;padding:88px 0;position:relative;overflow:hidden;
    background:linear-gradient(180deg,#0E1726 0%,#0A111C 100%);color:#fff}
  .sm-dark::before{content:"";position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(70% 90% at 82% -20%,rgba(120,160,220,.18),rgba(120,160,220,0) 62%)}
  .sm-dark-grid{display:grid;grid-template-columns:1fr 1.15fr;gap:96px;align-items:start;position:relative}
  .sm-dark .eyebrow{color:#94A1B5}
  .sm-dark .eyebrow i{background:#4C596E}
  .sm-dark h3{font-size:36px;color:#fff;max-width:420px}
  .sm-dark .lead{font-size:13px;line-height:1.7;color:rgba(255,255,255,.60);margin-top:14px;max-width:360px}
  .sm-dark .flink{color:#fff;margin-top:24px;font-size:12px}
  .auto{border-top:1px solid rgba(255,255,255,.15)}
  .arow{display:grid;grid-template-columns:1fr auto;gap:36px;align-items:start;
    padding:23px 0;border-bottom:1px solid rgba(255,255,255,.09)}
  .arow h4{font-size:16.5px;font-weight:500;letter-spacing:-.02em;color:#fff}
  .arow p{font-size:12px;line-height:1.65;color:rgba(255,255,255,.55);margin-top:6px;max-width:360px}
  .arow .rate{font-size:9px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
    color:rgba(255,255,255,.66);white-space:nowrap;padding-top:4px}

  /* 04 — asymmetric creative split */
  .sm-split{display:grid;grid-template-columns:380px 1fr;gap:100px;align-items:start}
  .sm-split h3{max-width:340px}
  .sm-split .lead{font-size:12.5px;line-height:1.75;color:var(--body);margin-top:12px;max-width:320px}
  .sm-split .flink{margin-top:20px;font-size:12px}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 56px;border-top:1px solid var(--line)}
  .grid2 .cell{padding:28px 2px 30px;border-bottom:1px solid var(--line2)}
  .grid2 h4{font-size:17px;font-weight:500;letter-spacing:-.025em}
  .grid2 p{font-size:12px;line-height:1.7;color:var(--body);margin-top:8px;max-width:230px}
  .grid2 .rate{display:block;font-size:9px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
    color:#A0AABB;margin-top:20px}
</style>
</head>
