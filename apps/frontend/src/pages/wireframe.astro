<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Bulk Communications Platform — Website Wireframes</title>
<style>
  @font-face{font-family:"Neometric";src:url("/assets/fonts/neometric-light.otf") format("opentype");font-weight:300;font-style:normal;font-display:swap}
  @font-face{font-family:"Neometric";src:url("/assets/fonts/neometric-regular.otf") format("opentype");font-weight:400;font-style:normal;font-display:swap}
  @font-face{font-family:"Neometric";src:url("/assets/fonts/neometric-medium.otf") format("opentype");font-weight:500;font-style:normal;font-display:swap}
  @font-face{font-family:"Neometric";src:url("/assets/fonts/neometric-bold.otf") format("opentype");font-weight:600;font-style:normal;font-display:swap}
  @font-face{font-family:"Neometric";src:url("/assets/fonts/neometric-heavy.otf") format("opentype");font-weight:800;font-style:normal;font-display:swap}

  :root{
    --ink:#0D131F; --body:#4A5566; --muted:#6B7688; --faint:#98A2B3;
    --line:#E8EBF0; --line2:#F1F3F7; --soft:#F7F8FB; --surf:#FCFCFD;
    --navy:#0B111B;
    --sh:0 1px 2px rgba(16,24,40,.04), 0 12px 32px -20px rgba(16,24,40,.16);
    --sh-lg:0 1px 2px rgba(16,24,40,.04), 0 32px 64px -32px rgba(16,24,40,.22);
    --sans:"Neometric",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    --mono:"Cascadia Mono",ui-monospace,SFMono-Regular,Consolas,monospace;
  }

  *{box-sizing:border-box}
  html{background:#E9ECF1;scroll-behavior:smooth}
  body{margin:0;background:#E9ECF1;color:var(--ink);font-family:var(--sans);
    -webkit-font-smoothing:antialiased;font-size:14px;line-height:1.55}
  h1,h2,h3,h4,h5,p{margin:0}
  h1,h2,h3,h4{font-weight:600;letter-spacing:-.04em;line-height:1.08}
  b,strong{font-weight:600}
  a{color:inherit;text-decoration:none}
  ul{margin:0;padding:0;list-style:none}
  ::selection{background:rgba(13,19,31,.10)}
  .ic{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}

  /* ---------- artboard canvas ---------- */
  .boards{display:flex;flex-direction:column;align-items:center;gap:44px;padding:36px 0 88px}
  .board{width:1440px;flex:none;background:#fff;overflow:hidden;border-radius:22px;scroll-margin-top:24px;
    box-shadow:0 2px 4px rgba(13,19,31,.04), 0 48px 96px -56px rgba(13,19,31,.45)}
  .wrap{width:1120px;margin:0 auto}

  /* ---------- shared ---------- */
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:10.5px;font-weight:600;
    letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
  .eyebrow i{width:5px;height:5px;border-radius:50%;background:var(--faint);flex:none}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:10px;
    padding:12px 22px;font-family:var(--sans);font-size:13px;font-weight:600;letter-spacing:-.005em;
    border:1px solid transparent;white-space:nowrap;line-height:1.2}
  .btn.sm{padding:9px 16px;font-size:12.5px;border-radius:9px}
  .btn.full{width:100%}
  .btn.green,.btn.navy{background:var(--ink);color:#fff;
    box-shadow:0 1px 2px rgba(13,19,31,.24), 0 10px 24px -14px rgba(13,19,31,.5)}
  .btn.ghost{background:#fff;border-color:#E3E7ED;color:var(--ink);box-shadow:0 1px 2px rgba(16,24,40,.04)}
  .btn.white{background:#fff;color:var(--ink);box-shadow:0 1px 2px rgba(13,19,31,.16)}
  .btn.outline-w{border-color:rgba(255,255,255,.28);color:#fff}
  .row{display:flex;gap:12px;margin-top:28px}
  .flink{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:#2F3A4B}
  .flink .ic{width:12px;height:12px}
  .section{padding:84px 0}
  .section.alt{background:var(--soft)}
  .sec-head{max-width:680px}
  .sec-head.center{text-align:center;margin:0 auto 40px}
  .sec-head h2{font-size:36px;letter-spacing:-.045em;line-height:1.12;margin-top:12px}
  .sec-head p{font-size:14px;line-height:1.7;color:var(--body);margin-top:12px;max-width:620px}
  .sec-head.center p{margin-left:auto;margin-right:auto}
  .tile{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;flex:none;
    background:#F3F5F9;color:#3F4A5C}
  .tile .ic{width:19px;height:19px;stroke-width:1.7}
  .tile.g,.tile.b,.tile.v,.tile.a,.tile.p,.tile.t{background:#F3F5F9;color:#3F4A5C}

  /* ---------- utility strip ---------- */
  .util{height:36px;border-bottom:1px solid var(--line2);background:#fff;font-size:10.5px;color:var(--muted)}
  .util-in{display:flex;align-items:center;justify-content:space-between;height:100%}
  .util-l,.util-r{display:flex;align-items:center;gap:16px}
  .util span{display:flex;align-items:center;gap:6px}
  .util .ic{width:11px;height:11px;color:var(--faint)}
  .util a.dlt{color:var(--ink);font-weight:600;display:flex;align-items:center;gap:6px}
  .util .sep{width:1px;height:12px;background:var(--line)}

  /* ---------- nav ---------- */
  .nav{height:74px;background:#fff}
  .nav-in{display:flex;align-items:center;justify-content:space-between;height:100%}
  .brand{display:flex;align-items:center;gap:11px}
  .brand .tile{width:34px;height:34px;border-radius:10px;background:var(--ink);display:grid;place-items:center;flex:none}
  .brand .mark{width:20px;height:20px;fill:none;stroke:#fff;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .brand .bname{display:block;font-size:15px;font-weight:600;letter-spacing:-.025em;line-height:1.05;white-space:nowrap}
  .brand .bname small{display:block;font-size:7px;font-weight:500;letter-spacing:.17em;text-transform:uppercase;color:var(--faint);margin-top:4px;line-height:1.4}
  .nav-links{display:flex;gap:28px;font-size:13px;font-weight:500;color:#55617A}
  .nav-links a.on{color:var(--ink);font-weight:600}
  .nav-right{display:flex;align-items:center;gap:18px;font-size:13px;font-weight:500}
  .login{color:#55617A}

  /* ---------- footer ---------- */
  .foot{background:var(--navy);color:#fff;padding:64px 0 30px}
  .foot-grid{display:grid;grid-template-columns:1.6fr .8fr .8fr .8fr .8fr;gap:40px}
  .foot .brand .bname{color:#fff}
  .foot .brand .bname small{color:#7C8798}
  .foot-brand .tag{font-size:12px;line-height:1.75;color:#8A95A6;margin-top:16px;max-width:276px}
  .foot-contact{margin-top:20px;display:flex;flex-direction:column;gap:8px}
  .foot-contact span{display:flex;align-items:center;gap:8px;font-size:11px;color:#B9C2CF}
  .foot-contact .ic{width:12px;height:12px;color:#7C8798}
  .social{display:flex;gap:8px;margin-top:20px}
  .social span{width:30px;height:30px;border:1px solid rgba(255,255,255,.13);border-radius:9px;
    display:grid;place-items:center;font-size:9px;font-weight:600;color:#C6CDD8}
  .fcol h5{font-size:9.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#7C8798;margin-bottom:16px}
  .fcol a{display:block;font-size:12px;color:#B9C2CF;line-height:2.2}
  .foot-base{border-top:1px solid rgba(255,255,255,.09);margin-top:48px;padding-top:20px;
    display:flex;align-items:center;justify-content:space-between;font-size:10.5px;color:#7C8798}
  .foot-base div{display:flex;gap:20px}

  /* ---------- home hero ---------- */
  .hero{display:grid;grid-template-columns:1fr 424px;gap:64px;align-items:start;padding:64px 0 56px}
  .hero h1{font-size:52px;line-height:1.05;letter-spacing:-.05em;margin-top:18px;max-width:648px;text-wrap:balance}
  .hero .sub{font-size:15.5px;line-height:1.7;color:var(--body);margin-top:18px;max-width:520px}
  .hero .row{margin-top:30px}
  .trustline{display:flex;gap:24px;margin-top:30px;font-size:11.5px;color:var(--muted)}
  .trustline span{display:flex;align-items:center;gap:7px}
  .trustline .ic{width:14px;height:14px;color:#55617A}

  /* ---------- quick enquiry card ---------- */
  .formcard{border:1px solid var(--line);border-radius:18px;background:#fff;padding:28px;box-shadow:var(--sh-lg)}
  .formcard h3{font-size:17px;letter-spacing:-.025em}
  .formcard .fh{font-size:11px;line-height:1.55;color:var(--muted);margin-top:4px}
  .fgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px}
  .fld{display:flex;flex-direction:column;gap:5px}
  .fld.full{grid-column:span 2}
  .fld label{font-size:8.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--faint)}
  .inp{height:42px;border:1px solid #E3E7ED;border-radius:10px;display:flex;align-items:center;
    justify-content:space-between;padding:0 12px;font-size:12px;color:var(--faint);background:#FCFCFD}
  .inp.area{height:86px;align-items:flex-start;padding-top:11px}
  .inp .ic{width:11px;height:11px}
  .agree{display:flex;gap:8px;align-items:flex-start;font-size:10px;color:var(--muted);margin-top:14px;line-height:1.55}
  .agree i{width:14px;height:14px;border:1px solid #DDE3EA;border-radius:4px;flex:none;margin-top:1px;background:#fff}
  .fnote{font-size:9px;color:var(--faint);margin-top:12px;text-align:center}

  /* ---------- industries ---------- */
  .indwrap{margin-top:48px;border-top:1px solid var(--line2);padding-top:32px}
  .indwrap>p{text-align:center;font-size:9.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--faint)}
  .indgrid{display:grid;grid-template-columns:repeat(6,1fr);margin-top:24px;background:var(--soft);
    border-radius:18px;padding:10px 8px}
  .inditem{height:56px;display:flex;align-items:center;justify-content:center;
    font-size:11.5px;color:var(--body);text-align:center;padding:0 10px}

  /* ---------- dark cta ---------- */
  .cta{padding:24px 0 72px}
  .cta-card{position:relative;overflow:hidden;background:var(--ink);border-radius:24px;padding:64px 40px;text-align:center}
  .cta-card::before{content:"";position:absolute;inset:0;
    background:radial-gradient(120% 140% at 50% 0%,rgba(255,255,255,.08),transparent 62%)}
  .cta-card h2{position:relative;color:#fff;font-size:38px;letter-spacing:-.05em;line-height:1.12;max-width:700px;margin:0 auto;text-wrap:balance}
  .cta-card p{position:relative;color:rgba(255,255,255,.64);font-size:13.5px;line-height:1.65;margin-top:12px}
  .cta-card .row{position:relative;justify-content:center;margin-top:26px}

  /* ---------- page hero ---------- */
  .phero{padding:56px 0 44px}
  .phero h1{font-size:50px;line-height:1.06;letter-spacing:-.05em;margin-top:14px;max-width:680px}
  .phero p{font-size:14.5px;line-height:1.7;color:var(--body);margin-top:14px;max-width:590px}
  .phero.center{text-align:center}
  .phero.center h1,.phero.center p{margin-left:auto;margin-right:auto}
  .phero-in{display:grid;grid-template-columns:1fr 392px;gap:64px;align-items:center}

  /* ---------- split head ---------- */
  .split-head{display:flex;align-items:flex-end;justify-content:space-between;gap:56px}
  .split-head>div:first-child{max-width:620px}
  .split-head .eyebrow{margin-bottom:12px}
  .split-head h2{font-size:34px;letter-spacing:-.045em;line-height:1.14}
  .split-side{max-width:352px;padding-bottom:4px}
  .split-side p{font-size:13px;line-height:1.65;color:var(--body)}
  .split-side .flink{margin-top:12px;font-size:12.5px;color:var(--body)}

  /* ---------- airy feature grids ---------- */
  .hgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:0 44px;margin-top:44px;
    border-top:1px solid var(--line2)}
  .hgrid.two{grid-template-columns:repeat(2,1fr)}
  .hgrid.four{grid-template-columns:repeat(4,1fr);gap:0 36px}
  .hcell{background:transparent;padding:30px 0 34px;display:flex;flex-direction:column;align-items:flex-start;
    border-bottom:1px solid var(--line2)}
  .hgrid.four .hcell{border-bottom:0;padding-bottom:0}
  .hcell>.tile{width:38px;height:38px;border-radius:11px}
  .hcell>.tile .ic{width:17px;height:17px}
  .hcell h4{font-size:15px;letter-spacing:-.025em;margin-top:16px}
  .hcell p{font-size:12.5px;line-height:1.65;color:var(--body);margin-top:6px;max-width:300px}
  .hcell .flink{margin-top:auto;padding-top:16px;font-size:12px;color:var(--body)}
  .hcell .num{font-size:10px;font-weight:600;letter-spacing:.13em;color:#A6AFBF;margin-bottom:12px}

  /* ---------- service groups ---------- */
  .grp{background:transparent;padding:30px 0 0;display:flex;flex-direction:column}
  .grp .gtop{display:flex;align-items:center;gap:8px;font-size:9.5px;font-weight:600;letter-spacing:.14em;
    text-transform:uppercase;color:#8B95A7;padding-bottom:0;border-bottom:0}
  .grp .gtop .ic{width:13px;height:13px;color:#6B7688}
  .grp h4{font-size:18px;letter-spacing:-.03em;margin-top:16px}
  .grp p{font-size:12.5px;line-height:1.6;color:var(--body);margin-top:6px;min-height:40px}
  .svc-row{display:flex;align-items:center;justify-content:space-between;gap:10px;
    padding:9px 0;border-bottom:1px solid var(--line2);font-size:12.5px;color:var(--body)}
  .svc-row:last-of-type{border-bottom:0}
  .svc-row span:last-child{font-size:10px;color:#C0C8D4;letter-spacing:.04em}
  .grp .flink{margin-top:auto;padding-top:18px;font-size:12.5px}

  /* ---------- service cards ---------- */
  .svcgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px}
  .svc{background:#fff;border:1px solid var(--line);border-radius:16px;padding:26px;
    display:flex;flex-direction:column;min-height:172px;box-shadow:var(--sh)}
  .svc .stag{align-self:flex-start;font-size:8.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
    color:#75808F;background:#F3F5F9;border-radius:999px;padding:4px 9px}
  .svc h4{font-size:15px;letter-spacing:-.025em;margin-top:14px}
  .svc p{font-size:12.5px;line-height:1.6;color:var(--body);margin-top:6px;max-width:300px}
  .svc .flink{margin-top:auto;padding-top:18px;font-size:12px;color:var(--body)}

  /* ---------- hcols ---------- */
  .hcols{display:grid;grid-template-columns:repeat(3,1fr);gap:56px;margin-top:40px;
    border-top:1px solid var(--line2);padding-top:36px}
  .hcols.four{grid-template-columns:repeat(4,1fr);gap:36px}
  .hcol>.tile{width:38px;height:38px;border-radius:11px}
  .hcol>.tile .ic{width:17px;height:17px}
  .hcol h4{font-size:14.5px;letter-spacing:-.025em;margin-top:16px}
  .hcol p{font-size:12.5px;line-height:1.65;color:var(--body);margin-top:7px;max-width:300px}
  .hcol small{display:block;font-size:10px;color:#8B95A7;margin-top:14px;
    border-top:1px solid var(--line2);padding-top:10px;max-width:300px}
  .hcol .flink{margin-top:10px;font-size:12px;color:var(--body)}

  /* ---------- pills ---------- */
  .pillbar{display:inline-flex;align-items:center;gap:2px;border:0;border-radius:999px;
    padding:4px;background:#F3F5F9}
  .pillbar span{font-size:12px;font-weight:500;color:#5A6678;padding:7px 16px;border-radius:999px;white-space:nowrap}
  .pillbar span.on{background:#fff;color:var(--ink);font-weight:600;box-shadow:0 1px 2px rgba(16,24,40,.08)}
  .pillrow{display:flex;justify-content:center;padding:28px 0 0}

  /* ---------- stats ---------- */
  .hstats{margin-top:56px;border-top:1px solid var(--line2);padding-top:36px}
  .hstats-top{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}
  .hstats-top h2{font-size:26px;letter-spacing:-.04em;margin-top:10px}
  .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:36px;margin-top:32px}
  .stat{padding:0;border:0}
  .stat b{display:block;font-size:44px;font-weight:600;letter-spacing:-.055em;color:var(--ink);line-height:1}
  .stat span{display:block;font-size:11.5px;line-height:1.6;color:#6B7688;margin-top:9px;max-width:200px}

  /* ---------- placeholder blocks ---------- */
  .ph{position:relative;display:grid;place-items:center;overflow:hidden;
    background:linear-gradient(180deg,#F9FAFC,#F3F5F8);border:1px solid #EDF0F4;border-radius:18px;color:#98A2B3}
  .ph::before{content:none}
  .ph-in{position:relative;display:flex;flex-direction:column;align-items:center;gap:9px;
    font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#8B95A7}
  .ph .ic{width:24px;height:24px;stroke-width:1.4}
  .ph-tag{font-size:9.5px;color:#7A8597;background:#F3F5F9;border:0;border-radius:999px;
    padding:4px 10px;white-space:nowrap}

  /* ---------- awards ---------- */
  .awards{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:36px}
  .aw{display:flex;align-items:center;gap:14px;border:0;border-radius:0;
    padding:0;background:transparent}
  .aw .badge{width:44px;height:44px;border-radius:50%;border:0;background:#F3F5F9;
    display:grid;place-items:center;color:#6B7688;flex:none}
  .aw .badge .ic{width:19px;height:19px}
  .aw b{display:block;font-size:12px;font-weight:600;line-height:1.4}
  .aw small{display:block;font-size:10px;color:#98A2B3;margin-top:3px}

  /* ---------- ticker ---------- */
  .ticker{display:flex;align-items:center;gap:14px;border-top:1px solid var(--line2);
    border-bottom:1px solid var(--line2);padding:14px 0;font-size:11.5px;color:var(--body)}
  .ticker .tlab{display:flex;align-items:center;gap:7px;font-size:9px;font-weight:600;
    letter-spacing:.14em;text-transform:uppercase;color:#98A2B3;flex:none}
  .ticker .tlab i{width:5px;height:5px;border-radius:50%;background:#55617A}
  .ticker .tline{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ticker .flink{font-size:11.5px;flex:none}

  /* ---------- story band ---------- */
  .storyband{display:grid;grid-template-columns:1fr 392px;gap:64px;align-items:center;padding:56px 0 54px}
  .storyband h2{font-size:32px;letter-spacing:-.045em;line-height:1.14;max-width:540px}
  .storyband p{font-size:13.5px;line-height:1.8;color:var(--body);margin-top:14px;max-width:570px}
  .storyband .meta{display:flex;gap:40px;margin-top:28px;padding-top:20px;border-top:1px solid var(--line2)}
  .storyband .meta b{display:block;font-size:22px;letter-spacing:-.045em;line-height:1.1}
  .storyband .meta small{display:block;font-size:10px;color:var(--faint);margin-top:4px}
  .storyband .ph{height:264px}

  /* ---------- quotes ---------- */
  .playgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:32px}
  .quote{border:1px solid var(--line);border-radius:18px;padding:28px;background:#fff;
    display:flex;flex-direction:column;box-shadow:var(--sh)}
  .quote .qm{width:30px;height:30px;border-radius:50%;background:#F3F5F9;color:#3F4A5C;
    display:grid;place-items:center;font-size:18px;font-weight:600;line-height:1;padding-top:7px}
  .quote blockquote{margin:16px 0 0;font-size:14.5px;line-height:1.6;letter-spacing:-.015em;color:var(--ink)}
  .quote .person{display:flex;align-items:center;gap:11px;margin-top:auto;padding-top:24px}
  .pav{width:34px;height:34px;border-radius:50%;background:#F3F5F9;color:#3F4A5C;
    display:grid;place-items:center;font-size:10.5px;font-weight:600;flex:none}
  .person b{display:block;font-size:11.5px;font-weight:600;line-height:1.4}
  .person small{display:block;font-size:10px;color:var(--faint)}

  /* ---------- pricing ---------- */
  .pr-hero{text-align:center;padding:64px 0 0}
  .pr-hero h1{font-size:50px;letter-spacing:-.052em;line-height:1.05;margin-top:14px}
  .pr-hero p{font-size:14.5px;line-height:1.7;color:var(--body);max-width:570px;margin:14px auto 0}
  .pr-tabs{display:flex;justify-content:center;margin-top:28px}
  .pr-body{display:grid;grid-template-columns:1fr 344px;gap:24px;padding:36px 0 0;align-items:start}
  .ptable{border:1px solid var(--line);border-radius:18px;background:#fff;overflow:hidden;box-shadow:var(--sh)}
  .pt-head{display:flex;align-items:center;justify-content:space-between;gap:12px;
    padding:18px 22px;border-bottom:1px solid var(--line2)}
  .pt-head b{font-size:13.5px}
  .pt-head span{font-size:9.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#98A2B3}
