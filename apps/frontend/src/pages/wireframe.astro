  .pfoot{display:flex;align-items:center;justify-content:space-between;gap:40px;border-top:1px solid var(--line);padding-top:26px;margin-top:6px}
  .pfoot p{font-size:11.5px;color:var(--muted);max-width:620px;line-height:1.75}

