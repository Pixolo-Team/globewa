    background:rgba(255,255,255,.13);color:#E4E7EC;border-radius:999px;padding:4px 9px}
  .plan .pdesc{font-size:12px;line-height:1.6;color:var(--muted);margin-top:6px;min-height:36px}
  .plan .amt{font-size:40px;font-weight:600;letter-spacing:-.05em;margin-top:18px;line-height:1}
